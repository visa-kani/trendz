{
  "name": "drift-commerce",
  "private": true,
  "version": "0.1.0",
  "description": "Drift Commerce — e-commerce, POS, inventory and billing platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:worker": "npm run worker:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
