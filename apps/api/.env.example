# =============================================================================
# Drift Commerce API — environment variables
# Copy to .env and fill in. Never commit .env files.
# Values below are safe placeholders for LOCAL development with docker compose.
# =============================================================================

NODE_ENV=development
PORT=4100
# Public origin of the web app (used in emails, redirects and CORS)
WEB_URL=http://localhost:3100
# Extra origins allowed to call the API cross-origin (comma separated).
# Browsers normally reach the API through the web origin, so this can stay empty.
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Cloudflare + Nginx = 2)
TRUST_PROXY=1
LOG_LEVEL=info

# --- Database & cache --------------------------------------------------------
DATABASE_URL=postgresql://drift:drift_local_pw@127.0.0.1:5544/drift?schema=public&connect_timeout=30
REDIS_URL=redis://127.0.0.1:6390/0

# --- Auth --------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to true in production (HTTPS only)
COOKIE_SECURE=false
# Leave empty for host-only cookies
COOKIE_DOMAIN=

# --- Payments: Razorpay ------------------------------------------------------
# razorpay | mock   (mock is refused when NODE_ENV=production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage: Cloudflare R2 (S3 compatible) ---------------------------
# For R2: R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Locally this points at the MinIO container.
R2_ACCOUNT_ID=
R2_ENDPOINT=http://localhost:9100
R2_ACCESS_KEY_ID=drift_minio
R2_SECRET_ACCESS_KEY=drift_minio_secret
R2_BUCKET_NAME=drift-media
# Public base URL that serves objects under the "public/" prefix
# (R2 custom domain, e.g. https://media.example.com). Locally: MinIO bucket URL.
R2_PUBLIC_URL=http://localhost:9100/drift-media
R2_FORCE_PATH_STYLE=true

# --- SMS ---------------------------------------------------------------------
# msg91 | console   (console is refused when NODE_ENV=production)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
# MSG91 DLT template ids (one per message type)
SMS_TEMPLATE_OTP=
SMS_TEMPLATE_ORDER=
SMS_TEMPLATE_SHIPPING=

# --- Email -------------------------------------------------------------------
# brevo | ses | smtp
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=orders@drift.local
EMAIL_FROM_NAME=Drift
# Amazon SES (when EMAIL_PROVIDER=ses)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SMTP (local Mailpit by default)
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Shipping: Shiprocket ----------------------------------------------------
# shiprocket | mock   (mock is refused when NODE_ENV=production)
SHIPPING_PROVIDER=mock
# Shiprocket API user email / password
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
# Shiprocket pickup location nickname configured in the Shiprocket panel
SHIPPING_PICKUP_LOCATION=Primary
# Token Shiprocket sends in the x-api-key header of webhook calls
SHIPPING_WEBHOOK_TOKEN=

# --- Bootstrap (seed) --------------------------------------------------------
SEED_ADMIN_EMAIL=admin@drift.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
